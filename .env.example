# Athena environment configuration
# Copy this file to .env and fill in values. Never commit .env to version control.

# Application data directory (defaults to ./data)
ATHENA_DATA_DIR=data

# SQLite database file name (relative to ATHENA_DATA_DIR)
ATHENA_DB_NAME=athena.db

# AI provider configuration (optional — v0.1 works without any AI provider)
# Leave unset to run in deterministic mode only. No AI call is made for core features.
ATHENA_AI_PROVIDER=
ATHENA_AI_API_KEY=

# Example (do not store real secrets here):
# ATHENA_AI_PROVIDER=openai
# ATHENA_AI_API_KEY=sk-...